 "roles": {
  "structure": {
   "rule": "Everything that holds the system up stays neutral: satin aluminium, white POM, black grip parts. Never coloured, so modules read against it.",
   "colours": [
    "#B9BBBC",
    "#A9ACAE",
    "#FFFAFA",
    "#1E1E1E"
   ]
  },
  "set_down": {
   "rule": "Green = horizontal surfaces you set things on (shelves).",
   "colours": [
    "#2F7A4B"
   ]
  },
  "water_soil": {
   "rule": "Red = anything that holds water or soil (planter tray, liners).",
   "colours": [
    "#D95942"
   ]
  },
  "hang": {
   "rule": "Yellow = vertical boards you hang things on (pegboard).",
   "colours": [
    "#FBCB44"
   ]
  },
  "pin": {
   "rule": "Blue = vertical boards you pin to (softboard felt).",
   "colours": [
    "#4569BE"
   ]
  },
  "write_power": {
   "rule": "White = boards you write on and powered attachment housings; only the LED dot carries light.",
   "colours": [
    "#FFFFFF",
    "#FFFAFA"
   ]
  },
  "plant": {
   "rule": "Real plant green is a prop, never a product colour.",
   "colours": [
    "#4F8A3C"
   ]
  },
  "diagram": {
   "rule": "In diagram shots everything goes muted grey except the subject (blue = powered parts, warm yellow glow = power path).",
   "colours": [
    "#D9D6D2",
    "#4569BE",
    "#FBCB44"
   ]
  },
  "top_mounted": "Anything mounted on a post top (attachments, end caps) is colour, never greyscale (abhik 2026-11-02)"
 },
 "rules": [
  "One colour per part. A module never mixes two theme colours.",
  "Colour says what a module does (see roles), structure stays neutral.",
  "Per scene: roughly 60% neutral structure, 30% one lead module colour, 10% the rest.",
  "Theme colours are the overgrwth wordmark set: blue #4569BE, green #2F7A4B, red #D95942, yellow #FBCB44, on pale #FFFAFA.",
  "New modules pick their colour from their role; add a new role before adding a new colour.",
  "Clamps and feet share one grey, darker than the frame (abhik 2026-11-02)",
  "No object faces away from the camera in any shot (abhik 2026-11-02)",
  "Interim CMF; full finalisation in overgrwth v3 (Nov 11)"
 ],
